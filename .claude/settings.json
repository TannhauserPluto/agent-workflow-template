{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *|*)",
      "Bash(wget *|*)",
      "Write(.env*)",
      "Edit(.env*)",
      "Write(.github/workflows/**)",
      "Edit(.github/workflows/**)"
    ],
    "ask": [
      "Bash",
      "Write",
      "Edit"
    ],
    "allow": [
      "Read",
      "LS",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(pwd)",
      "Bash(ls*)",
      "Bash(find*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_checkpoint.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool_use.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_gate.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
